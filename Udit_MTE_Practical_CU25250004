def solve():
    
    input_data = """1
3 2
4 5 6"""
    
    lines = input_data.strip().split('\n')
    T = int(lines[0].strip())
    idx = 1
    
    for _ in range(T):
        N, K = map(int, lines[idx].split())
        idx += 1
        A = list(map(int, lines[idx].split()))
        idx += 1
        
        # Sort based on Hamming distance from K, then by numerical value
        A.sort(key=lambda x: (bin(x ^ K).count('1'), x))
        
        print("Output:", *A)

if __name__ == '__main__':
    solve()
